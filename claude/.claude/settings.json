{
  "attribution": {
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(gh pr create:*)"
    ],
    "deny": [
      "Bash(security find-generic-password:*)",
      "Edit(~/dotfiles/claude/.claude/skills/anki-card-writing/anki.py)",
      "Edit(~/.claude/skills/anki-card-writing/anki.py)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "/Users/stevgouws/dotfiles/claude/.claude/skills",
      "/Users/steven.gouws/dotfiles/claude/.claude/skills",
      "/Users/steven.gouws/obsidian-sync/VoxSmart/tickets/"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX_PANE\" ] && printf '\\a' > \"$(tmux display -p -t \"$TMUX_PANE\" '#{pane_tty}')\" || true"
          },
          {
            "type": "command",
            "command": "\"$HOME/.config/scripts/ding\" play"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX_PANE\" ] && printf '\\a' > \"$(tmux display -p -t \"$TMUX_PANE\" '#{pane_tty}')\" || true"
          },
          {
            "type": "command",
            "command": "\"$HOME/.config/scripts/ding\" play"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "effortLevel": "medium",
  "voice": {
    "enabled": true,
    "mode": "tap"
  },
  "theme": "dark",
  "editorMode": "normal",
  "voiceEnabled": true,
  "network": {
    "allowedDomains": [
      "api.github.com",
      "github.com"
    ]
  }
}
