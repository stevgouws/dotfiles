#!/usr/bin/env bash
set -euo pipefail

# Defined before argument parsing because bash functions must exist before they're called.
usage() {
  cat <<'EOF'
Usage: tx [session] [options]

Open a tmux session for the current project, creating it if needed, then open
the project in VS Code and attach to the session (or switch to it if already
inside tmux).

The session name defaults to the current folder's name. The project root is the
git repo root, or the current folder outside a repo.

A new session is set up with the project's .tmux-setup.sh, or
~/.config/tmux/default-tmux-setup.sh if the project doesn't have one. An
existing session is left as it is.

Options:
  --run <command>  Run <command> in window 1 of a new session
  --detach         Create the session without opening VS Code or switching to it
  -h, --help       Show this help

Example:
  tx my-app --run "pnpm dev" --detach
EOF
}

# Exit code 2 means "called wrong", as opposed to 1 for "something failed".
usage_error() {
  echo "$1" >&2
  usage >&2
  exit 2
}

# Takes the option and the number of arguments left, e.g. `require_value "$1" $#`.
require_value() {
  if [[ $2 -lt 2 ]]; then
    usage_error "$1 needs a value"
  fi
}

RUN_CMD=""
SESSION=""
DETACH=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --run) require_value "$1" $#; RUN_CMD="$2"; shift 2 ;;
    --detach) DETACH=true; shift ;;
    -h|--help) usage; exit 0 ;;
    -*) usage_error "Unknown option: $1" ;;
    *)
      if [[ -z "$SESSION" ]]; then
        SESSION="$1"; shift
      else
        usage_error "Unknown argument: $1"
      fi
      ;;
  esac
done

SESSION="${SESSION:-$(basename "$PWD")}"
# tmux swaps "." and ":" in session names for "_" (e.g. "my.app" becomes
# "my_app"), so match that here or the has-session check below never finds it.
SESSION="${SESSION//[.:]/_}"
PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
PROJECT_TMUX_SETUP="$PROJECT_ROOT/.tmux-setup.sh"
if [[ ! -e "$PROJECT_TMUX_SETUP" ]]; then
  PROJECT_TMUX_SETUP="$HOME/.config/tmux/default-tmux-setup.sh"
fi

if [[ -e "$PROJECT_TMUX_SETUP" && ! -x "$PROJECT_TMUX_SETUP" ]]; then
  echo "$PROJECT_TMUX_SETUP exists but is not executable" >&2
  exit 1
fi

if ! tmux has-session -t "=${SESSION}" 2>/dev/null; then
  tmux new-session -d -s "$SESSION" -c "$PROJECT_ROOT"

  if [[ -n "$RUN_CMD" ]]; then
    tmux send-keys -t "=${SESSION}:1" "$RUN_CMD" Enter
  fi

  if [[ -x "$PROJECT_TMUX_SETUP" ]]; then
    "$PROJECT_TMUX_SETUP" "$SESSION" "$PROJECT_ROOT"
  fi
fi

# Lets a script (e.g. Claude handing work off to a new worktree) create the
# session without pulling your terminal over to it or opening VS Code.
if [[ "$DETACH" == true ]]; then
  echo "tmux session '$SESSION' is ready - $PROJECT_ROOT"
  exit 0
fi

code "$PROJECT_ROOT"
# If already in TMUX don't nest, just switch
if [[ -n "${TMUX:-}" ]]; then
  exec tmux switch-client -t "=${SESSION}"
else
  exec tmux attach -t "=${SESSION}"
fi
