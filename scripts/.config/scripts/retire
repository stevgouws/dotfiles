#!/usr/bin/env bash
set -euo pipefail

dir=$(basename "$PWD")

a=$((RANDOM % 8 + 2))
b=$((RANDOM % 8 + 2))
echo "Retiring '$dir'."
read -rp "$a + $b = ? " answer

if [ "$answer" != "$((a + b))" ]; then
  echo "Wrong answer, not retiring '$dir'"
  exit 1
fi

git worktree remove "$dir"

osascript - "$dir" <<'APPLESCRIPT'
on run argv
	set targetTitle to item 1 of argv

	tell application "System Events"
		tell process "Code"
			set targetWindows to windows whose name is targetTitle
			repeat with w in targetWindows
				try
					click button 1 of w
				end try
			end repeat
		end tell
	end tell
end run
APPLESCRIPT

tmux switch-client -t dotfiles
tmux kill-session -t "$dir"
