<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.stevgouws.backup-anki</string>

  <!-- Run through zsh so $HOME is expanded: launchd doesn't expand ~ or variables, and the home
       folder differs between Macs. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>"$HOME/.config/scripts/backup-anki" &gt;&gt; "$HOME/Library/Logs/backup-anki.log" 2&gt;&amp;1</string>
  </array>

  <!-- Daily at 12:00. If the Mac is asleep then, launchd runs it once on wake instead. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>12</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
</dict>
</plist>
